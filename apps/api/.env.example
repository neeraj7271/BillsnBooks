PORT=4000
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=app_user
DATABASE_PASSWORD=CHANGE_ME_IN_PRODUCTION
DATABASE_NAME=accounting_platform
DB_POOL_SIZE=20

REDIS_HOST=redis
REDIS_PORT=6379

JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARS!
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARS!
ENCRYPTION_KEY=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARS!

# Runtime mode: set to "production" in deployed environments. Controls CORS
# (localhost is only auto-allowed when NODE_ENV is not "production").
NODE_ENV=production

# Comma-separated list of browser origins allowed to call the API with
# credentials, e.g. https://app.yourdomain.com
CORS_ORIGINS=https://app.yourdomain.com

# SECURITY: the values below are development-only. Generate unique, random
# secrets of at least 32 characters for any shared or production environment,
# e.g. `openssl rand -base64 48`. The API refuses to start if any is missing
# or shorter than 32 characters.

# Optional: when set, payment-gateway callbacks must carry a valid HMAC-SHA256
# signature (hex) over "<linkId>|<amountPaid>" in the x-webhook-signature header
# or request body.
PAYMENT_WEBHOOK_SECRET=

# Observability & Logging
LOG_LEVEL=info
SENTRY_DSN=
METRICS_PORT=9090

# Storage (MinIO / AWS S3) for Invoice Logos, Digital Signatures, and Statements
S3_ENDPOINT=http://minio:9000
S3_BUCKET=accounting-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=CHANGE_MINIO_SECRET_KEY
S3_REGION=us-east-1

# SMTP Email Dispatch
SMTP_URL=smtp://smtp_user:smtp_pass@mailhog:1025
