PORT=4000
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=neeraj
DATABASE_PASSWORD=
DATABASE_NAME=accounting_platform
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=dev-jwt-secret-key-32-chars-long!
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-key-32-chars!
ENCRYPTION_KEY=dev-encryption-key-32-chars-long!


# Runtime mode: set to "production" in deployed environments. Controls CORS
# (localhost is only auto-allowed when NODE_ENV is not "production").
NODE_ENV=development

# Comma-separated list of browser origins allowed to call the API with
# credentials, e.g. https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# SECURITY: the values below are development-only. Generate unique, random
# secrets of at least 32 characters for any shared or production environment,
# e.g. `openssl rand -base64 48`. The API refuses to start if any is missing
# or shorter than 32 characters.

# Optional: when set, payment-gateway callbacks must carry a valid HMAC-SHA256
# signature (hex) over "<linkId>|<amountPaid>" in the x-webhook-signature header
# or request body. Leave unset only in local/dev where callbacks are simulated
# by an authenticated user.
PAYMENT_WEBHOOK_SECRET=
